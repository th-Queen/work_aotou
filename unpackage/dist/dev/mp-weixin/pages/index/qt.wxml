<view class="publish-container data-v-0a25cdaf"><view class="urgency-section data-v-0a25cdaf"><view class="{{['urgency-btn', 'urgent', 'data-v-0a25cdaf', a && 'active']}}" bindtap="{{b}}"> 重要紧急任务 </view><view class="{{['urgency-btn', 'normal', 'data-v-0a25cdaf', c && 'active']}}" bindtap="{{d}}"> 不紧急任务 </view></view><view class="task-section data-v-0a25cdaf"><text class="label data-v-0a25cdaf">任务名称</text><input placeholder="请输入任务名称" class="input data-v-0a25cdaf" value="{{e}}" bindinput="{{f}}"/><text class="label data-v-0a25cdaf">负责人</text><input placeholder="请输入负责人姓名" class="input data-v-0a25cdaf" value="{{g}}" bindinput="{{h}}"/><view class="process-list data-v-0a25cdaf"><view class="process-header data-v-0a25cdaf"><text class="data-v-0a25cdaf">工序列表</text><button bindtap="{{i}}" class="add-btn data-v-0a25cdaf">+ 新增工序</button></view><view wx:for="{{j}}" wx:for-item="process" wx:key="f" class="process-item data-v-0a25cdaf"><text class="process-index data-v-0a25cdaf">{{process.a}}.</text><view class="process-info data-v-0a25cdaf"><text class="process-name data-v-0a25cdaf">「{{process.b}}」</text><text class="process-desc data-v-0a25cdaf">人员: {{process.c}} | 时长: {{process.d}}h</text></view><button wx:if="{{k}}" bindtap="{{process.e}}" class="remove-btn data-v-0a25cdaf"> × </button></view></view><view wx:if="{{l}}" class="modal-mask data-v-0a25cdaf" bindtap="{{m}}"></view><view wx:if="{{n}}" class="modal data-v-0a25cdaf"><view class="modal-header data-v-0a25cdaf">新增工序</view><view class="modal-content data-v-0a25cdaf"><view class="modal-field data-v-0a25cdaf"><text class="modal-label data-v-0a25cdaf">工序名称</text><input placeholder="请输入工序名称" class="input modal-input data-v-0a25cdaf" maxlength="20" value="{{o}}" bindinput="{{p}}"/></view><view class="modal-field data-v-0a25cdaf"><text class="modal-label data-v-0a25cdaf">选择人员</text><picker class="data-v-0a25cdaf" mode="selector" range="{{r}}" bindchange="{{s}}"><view class="picker data-v-0a25cdaf">{{q}}</view></picker></view><view class="modal-field data-v-0a25cdaf"><text class="modal-label data-v-0a25cdaf">时长(h)</text><input type="number" placeholder="请输入时长:h" class="input modal-input data-v-0a25cdaf" min="0.5" step="0.5" value="{{t}}" bindinput="{{v}}"/></view></view><view class="modal-footer data-v-0a25cdaf"><button bindtap="{{w}}" class="modal-btn cancel data-v-0a25cdaf">取消</button><button bindtap="{{x}}" class="modal-btn confirm data-v-0a25cdaf">确定添加</button></view></view><button bindtap="{{z}}" disabled="{{A}}" class="{{['publish-btn', 'data-v-0a25cdaf', B && 'disabled']}}">{{y}}</button></view><button class="btn data-v-0a25cdaf" bindtap="{{C}}">查看品质部门人员任务</button></view>