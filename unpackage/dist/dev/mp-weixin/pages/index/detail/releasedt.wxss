
.task-container.data-v-472ab517 {
  padding: 20px;
  background-color: #f5f7fa;
  min-height: 100vh;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}
.header.data-v-472ab517 {
  font-size: 24px;
  font-weight: bold;
  color: #1a365d;
  text-align: center;
  margin-bottom: 25px;
  padding-bottom: 15px;
  border-bottom: 2px solid #eaeaea;
}
.task-card.data-v-472ab517 {
  background: white;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}
.task-card.data-v-472ab517:active {
  transform: translateY(1px);
}
.urgent-task.data-v-472ab517 {
  /* border-left: 4px solid #ff4d4f; */
}
.task-header.data-v-472ab517 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.task-title.data-v-472ab517 {
  font-size: 18px;
  font-weight: bold;
  color: #1a365d;
}
.urgency-tag.data-v-472ab517 {
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 500;
}
.urgent.data-v-472ab517 {
  background-color: #fff1f0;
  color: #ff4d4f;
  border: 1px solid #ffccc7;
}
.normal.data-v-472ab517 {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1px solid #b7eb8f;
}
.task-info.data-v-472ab517 {
  display: flex;
  justify-content: space-between;
  color: #666;
  font-size: 15px;
  margin-bottom: 20px;
  padding-bottom: 15px;
  border-bottom: 1px dashed #eee;
}
.action-buttons.data-v-472ab517 {
  display: flex;
  gap: 15px;
}
button.data-v-472ab517 {
  flex: 1;
  height: 48px;
  border-radius: 8px;
  font-size: 17px;
  font-weight: 500;
  border: none;
  color: white;
  box-shadow: 0 4px 10px rgba(24, 144, 255, 0.25);
  transition: all 0.2s;
}
button.data-v-472ab517:active {
  transform: translateY(1px);
  box-shadow: 0 2px 6px rgba(24, 144, 255, 0.35);
}
.btn-confirm.data-v-472ab517 {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
}
.btn-cancel.data-v-472ab517 {
  background: linear-gradient(135deg, #597ef7 0%, #3d5afe 100%);
}
.btn-active.data-v-472ab517 {
  opacity: 0.9;
  transform: translateY(2px) !important;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2) !important;
}
.empty-state.data-v-472ab517 {
  text-align: center;
  color: #999;
  font-size: 16px;
  margin-top: 50px;
  padding: 20px;
}
.advanced-fields.data-v-472ab517 {
  margin-top: 10px;
  padding: 8px 0;
  border-top: 1px dashed #eee;
  opacity: 0;
  height: 0;
  transition: all 0.3s;
}
.advanced-fields.expanded.data-v-472ab517 {
  opacity: 1;
  height: auto;
  padding: 8px 0;
}
.taskview.data-v-472ab517{
}
.taskview text.data-v-472ab517 {
	display: block;
	font-size: 26rpx;
	margin-bottom: 8rpx;
}
.advanced-toggle.data-v-472ab517 {
    display: flex;
    align-items: center;
    justify-content: center;
    /* border-top: 2rpx solid #f0f0f0; */
    color: #1890ff;
    font-size: 28rpx;
}
/* 工序列表 */
.advanced-fields.data-v-472ab517 {
    overflow: hidden;
    transition: all 0.3s ease;
    opacity: 0;
    max-height: 0;
}
.advanced-fields.expanded.data-v-472ab517 {
    opacity: 1;
    max-height: 1000px;
    margin-bottom: 20rpx;
}
.process-item.data-v-472ab517 {
    background-color: #f8f9fc;
    border-radius: 12rpx;
    padding: 20rpx;
    margin-bottom: 16rpx;
    border: 2rpx solid #eef2f6;
}
.process-header.data-v-472ab517 {
    margin-bottom: 12rpx;
}
.process-index.data-v-472ab517 {
    font-weight: 600;
    color: #1a365d;
    font-size: 28rpx;
    /* background: #e6f7ff; */
    padding: 4rpx 16rpx;
    display: inline-block;
}
.process-row.data-v-472ab517 {
    display: flex;
    align-items: baseline;
    margin-bottom: 8rpx;
    font-size: 26rpx;
}
.process-label.data-v-472ab517 {
    width: 140rpx;
    color: #666;
    flex-shrink: 0;
}
.process-value.data-v-472ab517 {
    color: #333;
    font-weight: 450;
    flex: 1;
    word-break: break-word;
}
