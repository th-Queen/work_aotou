
.container {
	padding: 20rpx;
}
.swiper {
	height: 380rpx;
	border-radius: 12rpx;
	overflow: hidden;
	margin-bottom: 30rpx;
}
.swiper-image {
	width: 100%;
	height: 100%;
}
.button {
	display: flex;
	align-items: center;
	gap: 40rpx;
	border: 3rpx solid #007aff;
	border-radius: 12rpx;
	padding: 30rpx;
	margin-bottom: 30rpx;
}
.btn {
	background: #007aff;
	color: white;
	border: none;
	border-radius: 8rpx;
	padding: 20rpx 30rpx;
	font-size: 28rpx;
	min-width: 200rpx;
/* 		background: #007aff;
		color: white;
		border: none;
		border-radius: 6rpx;
		padding: 16rpx 30rpx;
		font-size: 28rpx;
		margin-left: 20rpx; */
		transition: all 0.4s ease;  /* 新增：平滑过渡 */
}
.btn:active {  /* 新增：点击状态 */
    background: #0056cc;  /* 更深的蓝色 */
    transform: scale(0.95);  /* 轻微缩小 */
}
.company-images {
	display: flex;
	flex-direction: column;
	gap: 20rpx;
}
.company-image {
	width: 100%;
	height: 400rpx;
	border-radius: 8rpx;
}
